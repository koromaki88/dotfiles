#!/bin/sh

TYPE="${BLOCK_INSTANCE:-mem}"

awk -v type="$TYPE" '
/^MemAvailable:/ { available=$2 }
/^SwapTotal:/    { swap_total=$2 }
/^SwapFree:/     { swap_free=$2 }
END {
    if (type == "swap")
        printf("%.1fG\n", (swap_total-swap_free)/1024/1024)
    else
        printf("%.1fG\n", available/1024/1024)
}
' /proc/meminfo
